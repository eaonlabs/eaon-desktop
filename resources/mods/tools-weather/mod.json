{
  "schema": 1,
  "publisher": "Eaon",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "id": "eaon.tools-weather",
  "name": "Weather",
  "category": "tools",
  "description": "Lets agents look up places and weather forecasts from Open-Meteo. No account or key needed.",
  "homepage": "https://open-meteo.com/",
  "contributes": {
    "tools": [
      {
        "name": "weather_find_place",
        "description": "Find a place by name to get its latitude, longitude and time zone, for weather_forecast.",
        "url": "https://geocoding-api.open-meteo.com/v1/search?name={name}&count=5&format=json",
        "params": [
          {
            "name": "name",
            "type": "string",
            "description": "A city or place name, like \"Lisbon\" or \"Austin, Texas\".",
            "required": true
          }
        ],
        "pick": [
          "results.*.name",
          "results.*.admin1",
          "results.*.country",
          "results.*.latitude",
          "results.*.longitude",
          "results.*.timezone"
        ]
      },
      {
        "name": "weather_forecast",
        "description": "Current weather and a daily forecast for a latitude and longitude. weather_code is a WMO code: 0 clear, 1 to 3 partly cloudy to overcast, 45 and 48 fog, 51 to 67 drizzle or rain, 71 to 77 snow, 80 to 82 showers, 95 to 99 thunderstorms.",
        "url": "https://api.open-meteo.com/v1/forecast?latitude={latitude}&longitude={longitude}&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m,precipitation&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=auto&forecast_days={days}&temperature_unit={unit}",
        "params": [
          {
            "name": "latitude",
            "type": "number",
            "description": "Latitude in degrees.",
            "required": true
          },
          {
            "name": "longitude",
            "type": "number",
            "description": "Longitude in degrees.",
            "required": true
          },
          {
            "name": "days",
            "type": "integer",
            "description": "Days of forecast, 1 to 16. Defaults to 7."
          },
          {
            "name": "unit",
            "type": "string",
            "description": "celsius (the default) or fahrenheit.",
            "enum": [
              "celsius",
              "fahrenheit"
            ]
          }
        ],
        "pick": [
          "current",
          "current_units",
          "daily",
          "timezone"
        ]
      }
    ]
  }
}
