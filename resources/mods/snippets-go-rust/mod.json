{
  "schema": 1,
  "publisher": "Eaon",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "id": "eaon.snippets-go-rust",
  "name": "Go and Rust snippets",
  "category": "editor",
  "description": "Go and Rust snippets for the code editor: error checks, tests, structs, impls and matches.",
  "contributes": {
    "snippets": [
      {
        "prefix": "iferr",
        "description": "Return on error",
        "languages": [
          "go"
        ],
        "body": "if err != nil {\n\treturn $0err\n}"
      },
      {
        "prefix": "func",
        "description": "Function",
        "languages": [
          "go"
        ],
        "body": "func name() error {\n\t$0\n\treturn nil\n}"
      },
      {
        "prefix": "gomain",
        "description": "main package",
        "languages": [
          "go"
        ],
        "body": "package main\n\nimport \"fmt\"\n\nfunc main() {\n\tfmt.Println($0)\n}"
      },
      {
        "prefix": "gotest",
        "description": "Table test",
        "languages": [
          "go"
        ],
        "body": "func TestName(t *testing.T) {\n\ttests := []struct {\n\t\tname string\n\t}{\n\t\t{name: \"$0\"},\n\t}\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t})\n\t}\n}"
      },
      {
        "prefix": "fnmain",
        "description": "main function",
        "languages": [
          "rs"
        ],
        "body": "fn main() {\n    $0\n}"
      },
      {
        "prefix": "derive",
        "description": "Struct with derives",
        "languages": [
          "rs"
        ],
        "body": "#[derive(Debug, Clone, PartialEq)]\nstruct Name {\n    $0\n}"
      },
      {
        "prefix": "impl",
        "description": "impl block",
        "languages": [
          "rs"
        ],
        "body": "impl Name {\n    pub fn new() -> Self {\n        $0\n    }\n}"
      },
      {
        "prefix": "match",
        "description": "match on a Result",
        "languages": [
          "rs"
        ],
        "body": "match value {\n    Ok(v) => $0,\n    Err(e) => return Err(e.into()),\n}"
      },
      {
        "prefix": "rstest",
        "description": "Test module",
        "languages": [
          "rs"
        ],
        "body": "#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn works() {\n        $0\n    }\n}"
      }
    ]
  }
}
