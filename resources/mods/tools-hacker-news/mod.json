{
  "schema": 1,
  "publisher": "Eaon",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "id": "eaon.tools-hacker-news",
  "name": "Hacker News",
  "category": "tools",
  "description": "Lets agents read Hacker News: the front page, a search, and a story's comments.",
  "homepage": "https://hn.algolia.com/api",
  "contributes": {
    "tools": [
      {
        "name": "hn_front_page",
        "description": "The stories on Hacker News's front page now, with their links, points and comment counts. objectID is the story's id for hn_thread.",
        "url": "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage={count}",
        "params": [
          {
            "name": "count",
            "type": "integer",
            "description": "How many stories, up to 30. Defaults to 20."
          }
        ],
        "pick": [
          "hits.*.title",
          "hits.*.url",
          "hits.*.points",
          "hits.*.num_comments",
          "hits.*.objectID"
        ]
      },
      {
        "name": "hn_search",
        "description": "Search Hacker News stories by keyword.",
        "url": "https://hn.algolia.com/api/v1/search?query={query}&tags=story&hitsPerPage=10",
        "params": [
          {
            "name": "query",
            "type": "string",
            "description": "What to search for.",
            "required": true
          }
        ],
        "pick": [
          "hits.*.title",
          "hits.*.url",
          "hits.*.points",
          "hits.*.created_at",
          "hits.*.objectID"
        ]
      },
      {
        "name": "hn_thread",
        "description": "A Hacker News story and its top-level comments, by the story's id.",
        "url": "https://hn.algolia.com/api/v1/items/{id}",
        "params": [
          {
            "name": "id",
            "type": "string",
            "description": "The story's id (objectID).",
            "required": true
          }
        ],
        "pick": [
          "title",
          "url",
          "points",
          "text",
          "children.*.author",
          "children.*.text"
        ],
        "maxChars": 9000
      }
    ]
  }
}
