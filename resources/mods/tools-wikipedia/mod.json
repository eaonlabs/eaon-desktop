{
  "schema": 1,
  "publisher": "Eaon",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "id": "eaon.tools-wikipedia",
  "name": "Wikipedia",
  "category": "tools",
  "description": "Lets agents search English Wikipedia and read an article's summary.",
  "homepage": "https://en.wikipedia.org/",
  "contributes": {
    "tools": [
      {
        "name": "wikipedia_search",
        "description": "Search English Wikipedia. Returns matching article titles with a short snippet.",
        "url": "https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch={query}&format=json&srlimit=6",
        "params": [
          {
            "name": "query",
            "type": "string",
            "description": "What to search for.",
            "required": true
          }
        ],
        "pick": [
          "query.search.*.title",
          "query.search.*.snippet"
        ]
      },
      {
        "name": "wikipedia_summary",
        "description": "The summary of one English Wikipedia article, by its exact title (from wikipedia_search).",
        "url": "https://en.wikipedia.org/api/rest_v1/page/summary/{title}",
        "params": [
          {
            "name": "title",
            "type": "string",
            "description": "The article title, like \"Alan Turing\".",
            "required": true
          }
        ],
        "pick": [
          "title",
          "description",
          "extract",
          "content_urls.desktop.page"
        ]
      }
    ]
  }
}
