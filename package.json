{
  "name": "eaon-desktop",
  "version": "2026.6.0-rc.1",
  "description": "The Eaon desktop app — a bring-your-own-key AI chat client",
  "main": "./out/main/index.js",
  "author": "Eaon",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/eaonlabs/eaon-desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist:mac": "./scripts/release-mac.sh",
    "release:mac": "./scripts/release-mac.sh --publish",
    "dist:win": "[ -f resources/llama/win32-x64/llama-server.exe ] || ./scripts/fetch-llama-windows.sh; electron-vite build && electron-builder --win --publish never",
    "dist:linux": "./scripts/build-llama.sh && electron-vite build && electron-builder --linux --publish never",
    "release:win": "[ -f resources/llama/win32-x64/llama-server.exe ] || ./scripts/fetch-llama-windows.sh; electron-vite build && electron-builder --win --publish always",
    "test:main": "node scripts/test-main.mjs",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "verify:plugins": "node scripts/verify-plugins.mjs",
    "verify:models": "node scripts/verify-model-library.mjs",
    "generate:models": "node scripts/generate-models.mjs",
    "build:llama": "./scripts/build-llama.sh all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "baileys": "7.0.0-rc14",
    "betterwright": "2.8.8",
    "electron-updater": "^6.3.9",
    "node-pty": "^1.1.0",
    "postal-mime": "^4.0.2",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
