{
  "manifest_version": 3,
  "name": "Eaon Browser Control",
  "short_name": "Eaon",
  "version": "1.2.0",
  "description": "Lets Eaon use your browser for you: open, read and fill in pages, click, type, take screenshots, and send pages to Eaon.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Eaon",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Open the Eaon popup"
    },
    "stop-agent": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop the agent from using this browser"
    }
  },
  "permissions": ["alarms", "contextMenus", "scripting", "storage", "tabGroups"],
  "host_permissions": ["<all_urls>"]
}
