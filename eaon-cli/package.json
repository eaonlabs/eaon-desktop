{
  "name": "eaon-cli",
  "version": "0.4.0",
  "description": "An agentic coding agent in your terminal \u2014 plan mode, sub-agents, real tools, an account panel, and themes, for any model: local (Ollama) or hosted.",
  "type": "module",
  "license": "MIT",
  "author": "Eaon",
  "homepage": "https://eaon.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanscreates/eaon-desktop.git",
    "directory": "eaon-cli"
  },
  "bugs": {
    "url": "https://github.com/sanscreates/eaon-desktop/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "terminal",
    "llm",
    "ollama",
    "pair-programming",
    "developer-tools"
  ],
  "bin": {
    "eaon": "dist/cli.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "probe": "tsx probes/render-probe.tsx && tsx probes/account-probe.tsx && tsx probes/app-probe.tsx && tsx probes/login-probe.ts && EAON_NO_BROWSER=1 tsx probes/login-e2e-probe.tsx"
  },
  "dependencies": {
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "ink": "^5.1.0",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "trash": "^9.0.0"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
